# Copy to .env and fill in. NEVER commit .env.
# ---- App ----
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
# Paper trading only. Leave this false — the codebase has no live path.
LIVE_TRADING_ENABLED=false

# ---- CORS (comma-free JSON list for pydantic) ----
CORS_ORIGINS=["http://localhost:3000"]

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cie

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Freshness budgets (seconds) ----
TICKER_MAX_AGE_SECONDS=10
CANDLE_MAX_AGE_SECONDS=120

# ---- External data providers (Phase 2+). Keys go here, NEVER in git. ----
# COINBASE_API_KEY=
# KRAKEN_API_KEY=
